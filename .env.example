OPENAI_API_KEY=your_openai_api_key
TINYFISH_API_KEY=your_tinyfish_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini
TINYFISH_BASE_URL=https://agent.tinyfish.ai/v1
REPORT_OUTPUT_DIR=./runs
TINYFISH_DEFAULT_BROWSER_PROFILE=lite
TINYFISH_POLL_INTERVAL_SECONDS=5
TINYFISH_POLL_TIMEOUT_SECONDS=600
TINYFISH_BATCH_SIZE=20
TINYFISH_RETRY_WITH_STEALTH=true
TINYFISH_REQUEST_MAX_RETRIES=3
TINYFISH_REQUEST_RETRY_BACKOFF_SECONDS=2.0
